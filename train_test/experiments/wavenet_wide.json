{
    "_notes": "2-layer WaveNet, wide channels (32/16ch), Tanh. Isolates channel width effect vs standard_base.",
    "net": {
        "name": "WaveNet",
        "config": {
            "layers_configs": [
                {
                    "condition_size": 1,
                    "input_size": 1,
                    "channels": 32,
                    "head_size": 16,
                    "kernel_size": 3,
                    "dilations": [
                        1, 2, 4, 8, 16, 32, 64, 128, 256, 512
                    ],
                    "activation": "Tanh",
                    "head_bias": false
                },
                {
                    "condition_size": 1,
                    "input_size": 32,
                    "channels": 16,
                    "head_size": 1,
                    "kernel_size": 3,
                    "dilations": [
                        1, 2, 4, 8, 16, 32, 64, 128, 256, 512
                    ],
                    "activation": "Tanh",
                    "head_bias": true
                }
            ],
            "head_scale": 0.02
        }
    },
    "optimizer": {
        "lr": 0.004
    },
    "lr_scheduler": {
        "class": "ExponentialLR",
        "kwargs": {
            "gamma": 0.993
        }
    }
}
